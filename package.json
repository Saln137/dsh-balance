{
  "name": "dsh-balance",
  "version": "0.1.0",
  "private": true,
  "description": "DeepSeek Harness 插件：在桌面端侧边栏底部常驻实时显示账号余额。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "balance",
    "cordis"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "docs"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\"",
    "build": "pnpm run clean && tsdown",
    "prepare": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.ts\"",
    "verify": "pnpm run typecheck && pnpm run test && pnpm run build && node scripts/verify-bundles.mjs",
    "release": "pnpm run build && pnpm pack"
  },
  "packageManager": "pnpm@12.6.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.12",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  }
}
